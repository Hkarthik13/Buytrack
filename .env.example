# BuyTrack Environment Variables Template

# 1. Supabase PostgreSQL & Auth (Optional - if not provided, operates in smart persistent local demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Google Gemini API for Multi-modal Receipt OCR & Grounded AI Assistant (Optional - Heuristic intelligence handles fallback)
GEMINI_API_KEY=your-gemini-api-key
